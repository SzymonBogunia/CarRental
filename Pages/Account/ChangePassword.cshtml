@page
@model CarRental.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Zmiana hasła";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold">🔑 Zmiana hasła</h4>
            </div>
            <div class="card-body p-4">
                @if (Model.IsForced)
                {
                    <div class="alert alert-warning">
                        Musisz ustawić nowe hasło przed dalszą pracą (pierwsze logowanie, reset lub wygaśnięcie hasła).
                    </div>
                }
                @if (Model.Errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in Model.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <ul class="small text-muted">
                    <li>co najmniej @Model.MinLength znaków (długie hasło z kilku słów jest lepsze niż krótkie i skomplikowane),</li>
                    <li>spoza listy popularnych haseł i inne niż poprzednie,</li>
                    @if (Model.PersonalDataRuleEnabled)
                    {
                        <li>nie może zawierać loginu, imienia ani nazwiska.</li>
                    }
                </ul>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label fw-semibold">Obecne hasło</label>
                        <input asp-for="OldPassword" type="password" value="" class="form-control" autocomplete="current-password" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Nowe hasło</label>
                        <input asp-for="NewPassword" type="password" value="" class="form-control" autocomplete="new-password" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Powtórz nowe hasło</label>
                        <input asp-for="ConfirmPassword" type="password" value="" class="form-control" autocomplete="new-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Zmień hasło</button>
                </form>
            </div>
        </div>
    </div>
</div>
